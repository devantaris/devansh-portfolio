{
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/blueprint.html"
    }
  ],
  "redirects": [
    {
      "source": "/landing",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/landing/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/universe",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/universe/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/stderr",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/stderr/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blueprint",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blueprint/:path*",
      "destination": "/",
      "permanent": true
    }
  ]
}
